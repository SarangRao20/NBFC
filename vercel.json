{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanOutputs": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/docs",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/docs/(.*)",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://nbfc-inc.onrender.com",
    "NODE_ENV": "production"
  }
}
